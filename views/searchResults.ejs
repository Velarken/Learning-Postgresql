<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>
<body>
    <%- include('./partials/nav.ejs') %>
    <h1>Username Search Results</h1>
    <% data.forEach(row => { %>
        <% if (!row.username) { %>
            <p>Sorry, nothing found matching your search.</p> 
        <% } else { %>
            <p> <%= row.username %> </p>
        <% } %>
    <% }) %>
</body>
</html>